{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advertising Operations Client",
  "type": "object",
  "required": ["schemaVersion", "slug", "organizationName", "dashboardTitle", "portfolioLabel", "currency", "timezone", "metaAccountId", "metaTokenEnv", "storagePrefix", "defaultTargetSpendPercent", "brands", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "organizationName": { "type": "string", "minLength": 1 },
    "dashboardTitle": { "type": "string", "minLength": 1 },
    "portfolioLabel": { "type": "string", "minLength": 1 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "timezone": { "type": "string", "minLength": 1 },
    "metaAccountId": { "type": "string", "pattern": "^act_[0-9]+$" },
    "metaTokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "storagePrefix": { "type": "string", "pattern": "^[a-z0-9/-]+$" },
    "defaultTargetSpendPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "profile", "campaignKeywords"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "pageId": { "type": "string" },
          "profile": { "type": "string", "minLength": 1 },
          "campaignKeywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
